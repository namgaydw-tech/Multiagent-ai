# LLM provider (modular - never hard-code a vendor)
# backend options: openai_compatible | ollama | huggingface | local | cloud
LLM_BACKEND=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
# LLM_API_KEY=            # never commit real keys; keep them out of git
LLM_TEMPERATURE=0.0

# Optional: separate models per role (defaults to LLM_MODEL for all)
# LLM_MODEL_PROPONENT=
# LLM_MODEL_ARBITRATOR=

# Reproducibility
RANDOM_SEED=20261002

# Paths
# DATA_DIR=data
# OUTPUT_DIR=outputs
